<launch>

    <node
        pkg="mobile_robot_navigation"
        exec="navigate_to_position_server"
        name="navigate_to_position_server"
        output="screen"
    />

    <node
        pkg="mobile_robot_navigation"
        exec="navigate_to_position_client"
        name="navigate_to_position_client"
        output="screen"
    >
        <param name="target_x" value="5.0" />
        <param name="target_y" value="5.0" />
        <param name="show_feedback" value="True" />
    </node>

</launch>