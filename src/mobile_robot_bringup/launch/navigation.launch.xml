<launch>

    <node
        pkg="mobile_robot_navigation"
        exec="navigate_to_position_server"
        name="navigate_to_position_server"
        output="screen"
    >
        <param name="angle_tolerance" value="0.05" />
        <param name="distance_tolerance" value="0.1" />
        <param name="k_angular" value="1.0" />
        <param name="k_linear" value="0.8" />
        <param name="max_linear_velocity" value="0.6" />
    </node>    

    <node
        pkg="mobile_robot_navigation"
        exec="navigate_to_position_client"
        name="navigate_to_position_clien"
        output="screen"
    >
        <param name="target_x" value="5.0" />
        <param name="target_y" value="2.0" />
        <param name="show_feedback" value="False" />
        <param name="cancel_service_name" value="cancel_navigation" />
    </node> 

</launch>